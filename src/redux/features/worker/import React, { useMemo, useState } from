import React, { useMemo, useState } from "react";
import {
  useCreateFlatMutation,
  useDeleteFlatMutation,
  useGetFlatsQuery,
  useUpdateFlatMutation,
  type TFlat,
  type TFlatPayload,
} from "@/redux/features/flat/flatApi";

import FlatForm from "./FlatForm";

import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Download,
  Eye,
  Pencil,
  Plus,
  Search,
  Trash2,
} from "lucide-react";

type TMode = "add" | "edit" | "view";

const getFlats = (response: any): TFlat[] => {
  const value = response?.data;

  if (Array.isArray(value)) return value;
  if (Array.isArray(value?.result)) return value.result;

  return [];
};

const getSocietyId = (flat: TFlat): string =>
  typeof flat.societyId === "string"
    ? flat.societyId
    : flat.societyId?._id || "";

const getSocietyName = (flat: TFlat): string =>
  typeof flat.societyId === "object"
    ? flat.societyId?.name || "—"
    : "—";

const getErrorMessage = (error: any): string =>
  error?.data?.message || error?.message || "Something went wrong.";
http://192.168.1.35:5173/
const Flat: React.FC = () => {
  const [searchTerm, setSearchTerm] = useState("");
  const [societyFilter, setSocietyFilter] = useState("all");
  const [statusFilter, setStatusFilter] = useState("all");

  const [formOpen, setFormOpen] = useState(false);
  const [deleteOpen, setDeleteOpen] = useState(false);
  const [mode, setMode] = useState<TMode>("add");
  const [selectedFlat, setSelectedFlat] = useState<TFlat | null>(null);
  const [actionError, setActionError] = useState("");

  const {
    data: flatResponse,
    isLoading,
    isFetching,
    isError,
    refetch,
  } = useGetFlatsQuery();

  const [createFlat, { isLoading: isCreating }] = useCreateFlatMutation();
  const [updateFlat, { isLoading: isUpdating }] = useUpdateFlatMutation();
  const [deleteFlat, { isLoading: isDeleting }] = useDeleteFlatMutation();

  const flats = useMemo(() => getFlats(flatResponse), [flatResponse]);

  const filteredFlats = useMemo(() => {
    const search = searchTerm.trim().toLowerCase();

    return flats.filter((flat) => {
      const matchesSearch =
        !search ||
        (flat.flatNumber || "").toLowerCase().includes(search) ||
        (flat.block || "").toLowerCase().includes(search) ||
        (flat.flatType || "").toLowerCase().includes(search) ||
        getSocietyName(flat).toLowerCase().includes(search);

      const matchesSociety =
        societyFilter === "all" || getSocietyId(flat) === societyFilter;

      const matchesStatus =
        statusFilter === "all" || flat.status === statusFilter;

      return matchesSearch && matchesSociety && matchesStatus;
    });
  }, [flats, searchTerm, societyFilter, statusFilter]);

  const openAddForm = () => {
    setSelectedFlat(null);
    setMode("add");
    setActionError("");
    setFormOpen(true);
  };

  const openEditForm = (flat: TFlat) => {
    setSelectedFlat(flat);
    setMode("edit");
    setActionError("");
    setFormOpen(true);
  };

  const openViewForm = (flat: TFlat) => {
    setSelectedFlat(flat);
    setMode("view");
    setActionError("");
    setFormOpen(true);
  };

  const handleFormSubmit = async (payload: TFlatPayload) => {
    if (mode === "edit" && selectedFlat) {
      await updateFlat({
        id: selectedFlat._id,
        data: payload,
      }).unwrap();
    } else {
      await createFlat(payload).unwrap();
    }

    setFormOpen(false);
    setSelectedFlat(null);
    setActionError("");
  };

  const handleDelete = async () => {
    if (!selectedFlat) return;

    setActionError("");

    try {
      await deleteFlat(selectedFlat._id).unwrap();
      setDeleteOpen(false);
      setSelectedFlat(null);
    } catch (error) {
      setActionError(getErrorMessage(error));
    }
  };

  const exportCSV = () => {
    const headers = [
      "Society",
      "Flat Number",
      "Block / Wing",
      "Floor",
      "Flat Type",
      "Area (sq. ft.)",
      "Status",
      "Description",
    ];

    const rows = filteredFlats.map((flat) => [
      getSocietyName(flat),
      flat.flatNumber,
      flat.block || "",
      flat.floorNumber ?? "",
      flat.flatType,
      flat.area ?? "",
      flat.status,
      flat.description || "",
    ]);

    const escapeCSV = (value: unknown) =>
      `"${String(value ?? "").replace(/"/g, '""')}"`;

    const csv = [headers, ...rows]
      .map((row) => row.map(escapeCSV).join(","))
      .join("\r\n");

    const blob = new Blob(["\uFEFF" + csv], {
      type: "text/csv;charset=utf-8;",
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "flats.csv";
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  };

  const statusClass = (status: string) => {
    switch (status) {
      case "Available":
        return "bg-green-100 text-green-700";
      case "Occupied":
        return "bg-blue-100 text-blue-700";
      case "Maintenance":
        return "bg-orange-100 text-orange-700";
      default:
        return "bg-gray-100 text-gray-700";
    }
  };

  return (
    <div className="space-y-6 px-12 py-4">
      <div className="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div>
          <h1 className="text-2xl font-bold tracking-tight">
            Flat Management
          </h1>
          <p className="text-sm text-muted-foreground">
            Manage flats registered under your Societies.
          </p>
        </div>

        <div className="flex flex-wrap gap-2">
          <Button variant="outline" onClick={exportCSV}>
            <Download className="mr-2 h-4 w-4" />
            Export CSV
          </Button>

          <Button onClick={openAddForm}>
            <Plus className="mr-2 h-4 w-4" />
            Add Flat
          </Button>
        </div>
      </div>

      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium">Total Flats</CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-2xl font-bold">{flats.length}</p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium">Available</CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-2xl font-bold text-green-600">
              {flats.filter((flat) => flat.status === "Available").length}
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium">Occupied</CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-2xl font-bold text-blue-600">
              {flats.filter((flat) => flat.status === "Occupied").length}
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium">Maintenance</CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-2xl font-bold text-orange-600">
              {flats.filter((flat) => flat.status === "Maintenance").length}
            </p>
          </CardContent>
        </Card>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>All Flats</CardTitle>
        </CardHeader>

        <CardContent className="space-y-4">
          <div className="grid grid-cols-1 gap-3 md:grid-cols-3">
            <div className="relative">
              <Search className="absolute left-3 top-3 h-4 w-4 text-muted-foreground" />
              <Input
                className="pl-9"
                placeholder="Search Flat or Society..."
                value={searchTerm}
                onChange={(event) => setSearchTerm(event.target.value)}
              />
            </div>

            <Select value={societyFilter} onValueChange={setSocietyFilter}>
              <SelectTrigger>
                <SelectValue placeholder="Filter by Society" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All Societies</SelectItem>
                {Array.from(
                  new Map(
                    flats
                      .filter(
                        (flat) =>
                          typeof flat.societyId === "object" &&
                          flat.societyId?._id
                      )
                      .map((flat) => [
                        (flat.societyId as { _id: string })._id,
                        flat.societyId as {
                          _id: string;
                          name: string;
                        },
                      ])
                  ).values()
                ).map((society) => (
                  <SelectItem key={society._id} value={society._id}>
                    {society.name}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>

            <Select value={statusFilter} onValueChange={setStatusFilter}>
              <SelectTrigger>
                <SelectValue placeholder="Filter by Status" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All Statuses</SelectItem>
                <SelectItem value="Available">Available</SelectItem>
                <SelectItem value="Occupied">Occupied</SelectItem>
                <SelectItem value="Maintenance">Maintenance</SelectItem>
              </SelectContent>
            </Select>
          </div>

          {isLoading ? (
            <div className="py-10 text-center text-muted-foreground">
              Loading Flats...
            </div>
          ) : isError ? (
            <div className="space-y-3 py-10 text-center">
              <p className="text-sm text-red-600">
                Failed to load Flats. Please try again.
              </p>
              <Button variant="outline" onClick={() => refetch()}>
                Retry
              </Button>
            </div>
          ) : (
            <div className="overflow-x-auto rounded-md border">
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Society</TableHead>
                    <TableHead>Flat Number</TableHead>
                    <TableHead>Block / Wing</TableHead>
                    <TableHead>Floor</TableHead>
                    <TableHead>Type</TableHead>
                    <TableHead>Area (sq. ft.)</TableHead>
                    <TableHead>Status</TableHead>
                    <TableHead className="text-right">Actions</TableHead>
                  </TableRow>
                </TableHeader>

                <TableBody>
                  {filteredFlats.length === 0 ? (
                    <TableRow>
                      <TableCell
                        colSpan={8}
                        className="h-24 text-center text-muted-foreground"
                      >
                        No Flats found.
                      </TableCell>
                    </TableRow>
                  ) : (
                    filteredFlats.map((flat) => (
                      <TableRow key={flat._id}>
                        <TableCell className="font-medium">
                          {getSocietyName(flat)}
                        </TableCell>
                        <TableCell>{flat.flatNumber}</TableCell>
                        <TableCell>{flat.block || "—"}</TableCell>
                        <TableCell>{flat.floorNumber ?? "—"}</TableCell>
                        <TableCell>{flat.flatType}</TableCell>
                        <TableCell>{flat.area ?? "—"}</TableCell>
                        <TableCell>
                          <span
                            className={`inline-flex rounded-full px-2.5 py-1 text-xs font-medium ${statusClass(
                              flat.status
                            )}`}
                          >
                            {flat.status}
                          </span>
                        </TableCell>
                        <TableCell>
                          <div className="flex justify-end gap-1">
                            <Button
                              variant="ghost"
                              size="icon"
                              title="View Flat"
                              onClick={() => openViewForm(flat)}
                            >
                              <Eye className="h-4 w-4" />
                            </Button>

                            <Button
                              variant="ghost"
                              size="icon"
                              title="Edit Flat"
                              onClick={() => openEditForm(flat)}
                            >
                              <Pencil className="h-4 w-4" />
                            </Button>

                            <Button
                              variant="ghost"
                              size="icon"
                              title="Delete Flat"
                              className="text-red-600 hover:text-red-700"
                              onClick={() => {
                                setSelectedFlat(flat);
                                setActionError("");
                                setDeleteOpen(true);
                              }}
                            >
                              <Trash2 className="h-4 w-4" />
                            </Button>
                          </div>
                        </TableCell>
                      </TableRow>
                    ))
                  )}
                </TableBody>
              </Table>
            </div>
          )}

          {isFetching && !isLoading && (
            <p className="text-xs text-muted-foreground">Refreshing data...</p>
          )}
        </CardContent>
      </Card>

      {/* Add / Edit / View Flat */}
      <Dialog
        open={formOpen}
        onOpenChange={(open) => {
          setFormOpen(open);
          if (!open) setSelectedFlat(null);
        }}
      >
        <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-2xl">
          <DialogHeader>
            <DialogTitle>
              {mode === "add"
                ? "Add Flat"
                : mode === "edit"
                ? "Edit Flat"
                : "View Flat"}
            </DialogTitle>
            <DialogDescription>
              {mode === "view"
                ? "Flat information and details."
                : "Enter the Flat information below."}
            </DialogDescription>
          </DialogHeader>

          <FlatForm
            key={`${mode}-${selectedFlat?._id || "new"}`}
            initialData={selectedFlat}
            mode={mode}
            loading={isCreating || isUpdating}
            onSubmit={handleFormSubmit}
            onClose={() => {
              setFormOpen(false);
              setSelectedFlat(null);
            }}
          />
        </DialogContent>
      </Dialog>

      {/* Delete confirmation */}
      <Dialog
        open={deleteOpen}
        onOpenChange={(open) => {
          setDeleteOpen(open);
          if (!open) setActionError("");
        }}
      >
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>Delete Flat</DialogTitle>
            <DialogDescription>
              Are you sure you want to delete Flat{" "}
              <strong>{selectedFlat?.flatNumber}</strong>? This action will
              soft-delete the record.
            </DialogDescription>
          </DialogHeader>

          {actionError && (
            <p role="alert" className="text-sm text-red-600">
              {actionError}
            </p>
          )}

          <DialogFooter>
            <Button
              variant="outline"
              onClick={() => setDeleteOpen(false)}
              disabled={isDeleting}
            >
              Cancel
            </Button>
            <Button
              variant="destructive"
              onClick={handleDelete}
              disabled={isDeleting}
            >
              {isDeleting ? "Deleting..." : "Delete"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
};

