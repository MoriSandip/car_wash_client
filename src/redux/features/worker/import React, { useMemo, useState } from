import React, { useEffect, useState } from "react";
import type {
  TFlat,
  TFlatPayload,
  TFlatStatus,
} from "@/redux/features/flat/flatApi";
import { useGetSocietiesQuery } from "@/redux/features/society/societyApi";

import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

type TSocietyOption = {
  _id: string;
  name: string;
  city?: string;
};

type TFlatFormProps = {
  initialData?: TFlat | null;
  mode: "add" | "edit" | "view";
  loading?: boolean;
  onSubmit: (data: TFlatPayload) => Promise<void> | void;
  onClose: () => void;
};

const defaultForm: TFlatPayload = {
  societyId: "",
  flatNumber: "",
  block: "",
  floorNumber: undefined,
  flatType: "2 BHK",
  area: undefined,
  status: "Available",
  description: "",
};

const getSocieties = (response: any): TSocietyOption[] => {
  const value = response?.data;

  if (Array.isArray(value)) return value;
  if (Array.isArray(value?.result)) return value.result;

  return [];
};

const getSocietyId = (flat?: TFlat | null): string => {
  if (!flat) return "";

  return typeof flat.societyId === "string"
    ? flat.societyId
    : flat.societyId?._id || "";
};

const FlatForm: React.FC<TFlatFormProps> = ({
  initialData,
  mode,
  loading = false,
  onSubmit,
  onClose,
}) => {
  const [form, setForm] = useState<TFlatPayload>(defaultForm);
  const [error, setError] = useState("");

  const { data: societyResponse, isLoading: societiesLoading } =
    useGetSocietiesQuery();

  const societies = getSocieties(societyResponse);
  const isView = mode === "view";

  useEffect(() => {
    if (initialData) {
      setForm({
        societyId: getSocietyId(initialData),
        flatNumber: initialData.flatNumber || "",
        block: initialData.block || "",
        floorNumber: initialData.floorNumber,
        flatType: initialData.flatType || "2 BHK",
        area: initialData.area,
        status: initialData.status || "Available",
        description: initialData.description || "",
      });
    } else {
      setForm(defaultForm);
    }

    setError("");
  }, [initialData, mode]);

  const updateField = <K extends keyof TFlatPayload>(
    key: K,
    value: TFlatPayload[K]
  ) => {
    setForm((previous) => ({ ...previous, [key]: value }));
  };

  const handleSubmit = async (event: React.FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setError("");

    if (!form.societyId) {
      setError("Please select a Society.");
      return;
    }

    if (!form.flatNumber.trim()) {
      setError("Flat Number is required.");
      return;
    }

    if (!form.flatType.trim()) {
      setError("Flat Type is required.");
      return;
    }

    const payload: TFlatPayload = {
      societyId: form.societyId,
      flatNumber: form.flatNumber.trim().toUpperCase(),
      block: form.block?.trim() || "",
      floorNumber:
        form.floorNumber === undefined || Number.isNaN(form.floorNumber)
          ? undefined
          : Number(form.floorNumber),
      flatType: form.flatType,
      area:
        form.area === undefined || Number.isNaN(form.area)
          ? undefined
          : Number(form.area),
      status: form.status,
      description: form.description?.trim() || "",
    };

    try {
      await onSubmit(payload);
    } catch (err: any) {
      setError(
        err?.data?.message ||
          err?.message ||
          "Unable to save Flat. Please try again."
      );
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-5">
      <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div className="space-y-2 md:col-span-2">
          <Label htmlFor="societyId">Society *</Label>
          <Select
            value={form.societyId}
            onValueChange={(value) => updateField("societyId", value)}
            disabled={isView || societiesLoading}
          >
            <SelectTrigger id="societyId">
              <SelectValue
                placeholder={
                  societiesLoading ? "Loading Societies..." : "Select Society"
                }
              />
            </SelectTrigger>
            <SelectContent>
              {societies.map((society) => (
                <SelectItem key={society._id} value={society._id}>
                  {society.name}
                  {society.city ? ` — ${society.city}` : ""}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>

        <div className="space-y-2">
          <Label htmlFor="flatNumber">Flat Number *</Label>
          <Input
            id="flatNumber"
            value={form.flatNumber}
            onChange={(event) =>
              updateField("flatNumber", event.target.value.toUpperCase())
            }
            placeholder="e.g. A-101"
            maxLength={30}
            required
            disabled={isView}
          />
        </div>

        <div className="space-y-2">
          <Label htmlFor="block">Block / Wing</Label>
          <Input
            id="block"
            value={form.block || ""}
            onChange={(event) => updateField("block", event.target.value)}
            placeholder="e.g. A Wing"
            disabled={isView}
          />
        </div>

        <div className="space-y-2">
          <Label htmlFor="floorNumber">Floor Number</Label>
          <Input
            id="floorNumber"
            type="number"
            min={0}
            value={form.floorNumber ?? ""}
            onChange={(event) =>
              updateField(
                "floorNumber",
                event.target.value === "" ? undefined : Number(event.target.value)
              )
            }
            placeholder="e.g. 1"
            disabled={isView}
          />
        </div>

        <div className="space-y-2">
          <Label htmlFor="flatType">Flat Type *</Label>
          <Select
            value={form.flatType}
            onValueChange={(value) => updateField("flatType", value)}
            disabled={isView}
          >
            <SelectTrigger id="flatType">
              <SelectValue placeholder="Select Flat Type" />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="1 BHK">1 BHK</SelectItem>
              <SelectItem value="2 BHK">2 BHK</SelectItem>
              <SelectItem value="3 BHK">3 BHK</SelectItem>
              <SelectItem value="4 BHK">4 BHK</SelectItem>
              <SelectItem value="5 BHK">5 BHK</SelectItem>
              <SelectItem value="Studio">Studio</SelectItem>
              <SelectItem value="Shop">Shop</SelectItem>
              <SelectItem value="Office">Office</SelectItem>
              <SelectItem value="Other">Other</SelectItem>
            </SelectContent>
          </Select>
        </div>

        <div className="space-y-2">
          <Label htmlFor="area">Area (sq. ft.)</Label>
          <Input
            id="area"
            type="number"
            min={0}
            value={form.area ?? ""}
            onChange={(event) =>
              updateField(
                "area",
                event.target.value === "" ? undefined : Number(event.target.value)
              )
            }
            placeholder="e.g. 1200"
            disabled={isView}
          />
        </div>

        <div className="space-y-2">
          <Label htmlFor="status">Status *</Label>
          <Select
            value={form.status}
            onValueChange={(value) =>
              updateField("status", value as TFlatStatus)
            }
            disabled={isView}
          >
            <SelectTrigger id="status">
              <SelectValue placeholder="Select Status" />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="Available">Available</SelectItem>
              <SelectItem value="Occupied">Occupied</SelectItem>
              <SelectItem value="Maintenance">Maintenance</SelectItem>
            </SelectContent>
          </Select>
        </div>

        <div className="space-y-2 md:col-span-2">
          <Label htmlFor="description">Description</Label>
          <Textarea
            id="description"
            value={form.description || ""}
            onChange={(event) =>
              updateField("description", event.target.value)
            }
            placeholder="Enter optional details..."
            rows={3}
            disabled={isView}
          />
        </div>
      </div>

      {error && (
        <p role="alert" className="text-sm font-medium text-red-600">
          {error}
        </p>
      )}

      <div className="flex justify-end gap-2 border-t pt-4">
        <Button type="button" variant="outline" onClick={onClose}>
          {isView ? "Close" : "Cancel"}
        </Button>

        {!isView && (
          <Button type="submit" disabled={loading}>
            {loading
              ? "Saving..."
              : mode === "edit"
              ? "Update Flat"
              : "Create Flat"}
          </Button>
        )}
      </div>
    </form>
  );
};

export default FlatForm;

import { baseApi } from "../../api/baseApi";

export type TFlatStatus = "Available" | "Occupied" | "Maintenance";

export type TFlat = {
  _id: string;
  societyId:
    | string
    | {
        _id: string;
        name: string;
        city?: string;
        address?: string;
      };
  flatNumber: string;
  block?: string;
  floorNumber?: number;
  flatType: string;
  area?: number;
  status: TFlatStatus;
  description?: string;
  isDeleted?: boolean;
  createdAt?: string;
  updatedAt?: string;
};

export type TFlatPayload = {
